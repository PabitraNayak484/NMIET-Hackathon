# SATHI Backend — environment configuration
# Copy this to .env and fill in your values.

# ── LLM: OpenRouter (Qwen 3) ──────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use (default: qwen/qwen3-235b-a22b)
# Faster/cheaper alternatives:
#   qwen/qwen3-8b               — smallest, fastest
#   qwen/qwen3-30b-a3b          — balanced
#   qwen/qwen3-235b-a22b        — most capable (default)
QWEN_MODEL=qwen/qwen3-235b-a22b

# ── Database ────────────────────────────────────────────────────────────────────
# SQLite by default; swap to postgres:// for production
DATABASE_URL=sqlite:///./sathi.db

# ── Content packs directory ─────────────────────────────────────────────────────
# Relative to the backend/ folder
CONTENT_PACKS_DIR=../content/packs

# ── CORS — comma-separated allowed origins ─────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Rate limiting (requests per minute per IP) ─────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Environment tag  (development | production) ─────────────────────────────────
ENVIRONMENT=development
