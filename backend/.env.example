# SATHI Backend — environment configuration
# Copy this to .env and fill in your values.

# Anthropic (LLM gateway)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Database (SQLite by default; swap to postgres:// for production)
DATABASE_URL=sqlite:///./sathi.db

# Content packs directory (relative to repo root)
CONTENT_PACKS_DIR=../content/packs

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Environment tag  (development | production)
ENVIRONMENT=development
