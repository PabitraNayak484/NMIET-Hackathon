# SATHI Frontend — environment configuration
# Copy this to .env and fill in values.

# Backend API base URL (no trailing slash)
# Points to the FastAPI backend.
# Leave as /api when running behind a reverse proxy.
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "true" to always show the Debug Panel (⚙ bottom-right corner)
# You can also activate per-session with ?debug=1 in the URL
VITE_DEBUG_PANEL=false
